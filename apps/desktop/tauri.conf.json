{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArmaXSync",
  "version": "0.1.0",
  "identifier": "eu.armaxsync.app",
  "build": {
    "frontendDist": "../../ui/apps/desktop/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ../ui --filter desktop dev",
    "beforeBuildCommand": "pnpm -C ../ui --filter desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "ArmaXSync",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["armaxsync"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Game",
    "shortDescription": "Arma mod repository sync and launcher",
    "longDescription": "Synchronize Arma 3 mod repositories (ArmA3Sync compatible) and launch the game with your modsets.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "GPL-3.0-or-later",
    "linux": { "deb": { "depends": [] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
